{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigil.example/contracts/deployment-manifest-v1.json",
  "title": "Vigil managed dedicated DeploymentManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "tenant_id",
    "deployment_id",
    "incarnation",
    "generation",
    "expected_generation",
    "mode",
    "placement",
    "releases",
    "isolation",
    "storage",
    "credentials",
    "network",
    "operations"
  ],
  "properties": {
    "contract_version": {"const": "managed-soc/v1"},
    "tenant_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"},
    "deployment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"},
    "incarnation": {"type": "string", "format": "uuid"},
    "generation": {"type": "integer", "minimum": 1},
    "expected_generation": {"type": "integer", "minimum": 0},
    "mode": {"const": "managed-dedicated"},
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "account_binding_ref", "region", "network_binding_ref", "state_binding_ref"],
      "properties": {
        "adapter": {"const": "aws-kubernetes"},
        "account_binding_ref": {"$ref": "#/$defs/localRef"},
        "region": {"type": "string", "pattern": "^[a-z]{2}-[a-z]+-[1-9][0-9]*$"},
        "network_binding_ref": {"$ref": "#/$defs/localRef"},
        "state_binding_ref": {"$ref": "#/$defs/localRef"}
      }
    },
    "releases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "harness", "infrastructure", "database_schema", "policy", "dspy"],
      "properties": {
        "application": {"$ref": "#/$defs/release"},
        "harness": {"$ref": "#/$defs/release"},
        "infrastructure": {"$ref": "#/$defs/release"},
        "database_schema": {"type": "string", "minLength": 1, "maxLength": 128},
        "policy": {"$ref": "#/$defs/release"},
        "dspy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["program_id", "version", "digest_ref", "approval_ref", "model_config_ref"],
          "properties": {
            "program_id": {"type": "string", "minLength": 1, "maxLength": 128},
            "version": {"type": "string", "minLength": 1, "maxLength": 128},
            "digest_ref": {"$ref": "#/$defs/approvedRef"},
            "approval_ref": {"$ref": "#/$defs/localRef"},
            "model_config_ref": {"$ref": "#/$defs/localRef"}
          }
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "execution", "database", "queue_cache"],
      "properties": {
        "application": {"const": "dedicated-runtime"},
        "execution": {"const": "dedicated-tenant-nodes"},
        "database": {"const": "dedicated-instance"},
        "queue_cache": {"const": "dedicated-instance"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database_ref", "object_store_ref", "memory_ref", "queue_ref", "key_ref", "retention_policy_ref"],
      "properties": {
        "database_ref": {"$ref": "#/$defs/localRef"},
        "object_store_ref": {"$ref": "#/$defs/localRef"},
        "memory_ref": {"$ref": "#/$defs/localRef"},
        "queue_ref": {"$ref": "#/$defs/localRef"},
        "key_ref": {"$ref": "#/$defs/localRef"},
        "retention_policy_ref": {"$ref": "#/$defs/localRef"}
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integration_secret_refs", "workload_identity_ref"],
      "properties": {
        "integration_secret_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/localRef"}},
        "workload_identity_ref": {"$ref": "#/$defs/localRef"}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingress_policy_ref", "egress_policy_ref", "management_transport", "artifact_mirror_ref"],
      "properties": {
        "ingress_policy_ref": {"$ref": "#/$defs/localRef"},
        "egress_policy_ref": {"$ref": "#/$defs/localRef"},
        "management_transport": {"const": "outbound-mtls-https"},
        "artifact_mirror_ref": {"$ref": "#/$defs/localRef"}
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_policy_ref", "export_policy_ref", "backup_policy_ref", "recovery_targets_ref", "maintenance_policy_ref", "support_policy_ref", "approval_ref", "rollback_compatibility_ref"],
      "properties": {
        "budget_policy_ref": {"$ref": "#/$defs/localRef"},
        "export_policy_ref": {"$ref": "#/$defs/localRef"},
        "backup_policy_ref": {"$ref": "#/$defs/localRef"},
        "recovery_targets_ref": {"$ref": "#/$defs/localRef"},
        "maintenance_policy_ref": {"$ref": "#/$defs/localRef"},
        "support_policy_ref": {"$ref": "#/$defs/localRef"},
        "approval_ref": {"$ref": "#/$defs/localRef"},
        "rollback_compatibility_ref": {"$ref": "#/$defs/approvedRef"}
      }
    }
  },
  "$defs": {
    "localRef": {"type": "string", "pattern": "^local:[a-zA-Z0-9][a-zA-Z0-9._/-]{0,254}$"},
    "approvedRef": {"type": "string", "pattern": "^approved:sha256:[a-f0-9]{64}$"},
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest_ref"],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "digest_ref": {"$ref": "#/$defs/approvedRef"}
      }
    }
  }
}
