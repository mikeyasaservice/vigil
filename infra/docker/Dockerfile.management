FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY services/management/requirements.txt /tmp/management-requirements.txt
RUN pip install -r /tmp/management-requirements.txt \
    && addgroup --system --gid 10001 vigil \
    && adduser --system --uid 10001 --ingroup vigil --home /nonexistent --no-create-home vigil

COPY core /app/core
COPY services/management /app/services/management

USER 10001:10001
EXPOSE 8443
ENTRYPOINT ["python", "-m", "services.management.serve"]
